---
// Menús desplegables del header: uno por año de la carrera, con sus materias en orden
// alfabético. Usa la API nativa `popover` (cierre al hacer clic afuera y con Escape).
import { years } from '../config/sidebar.mjs';

const current = Astro.url.pathname;
---

<nav class="year-menu" aria-label="Materias por año">
	{years.map(({ year, label, subjects }) => {
		const active = subjects.some(subject => current.startsWith(subject.href));
		return (
			<div class="year-menu-item">
				<button
					type="button"
					class:list={['year-menu-trigger', { active }]}
					popovertarget={`year-menu-${year}`}
					aria-haspopup="true"
					aria-expanded="false"
				>
					{label}
					<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
				</button>
				<div id={`year-menu-${year}`} class="year-menu-panel" popover>
					<ul>
						{subjects.map(subject => (
							<li>
								<a href={subject.href} aria-current={current.startsWith(subject.href) ? 'true' : undefined}>{subject.label}</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		);
	})}
</nav>

<script>
	for (const panel of document.querySelectorAll<HTMLElement>('.year-menu-panel')) {
		const trigger = document.querySelector<HTMLButtonElement>(`[popovertarget="${panel.id}"]`);
		if (!trigger) continue;
		panel.addEventListener('beforetoggle', event => {
			const opening = (event as ToggleEvent).newState === 'open';
			trigger.setAttribute('aria-expanded', String(opening));
			if (!opening) return;
			// Debajo del botón, sin salirse de la ventana.
			const box = trigger.getBoundingClientRect();
			panel.style.top = `${box.bottom + 6}px`;
			panel.style.left = `${Math.max(8, Math.min(box.left, window.innerWidth - 288))}px`;
		});
		panel.addEventListener('toggle', event => {
			if ((event as ToggleEvent).newState === 'open') panel.querySelector<HTMLAnchorElement>('a')?.focus();
		});
	}
</script>

<style>
	.year-menu {
		display: none;
		align-items: center;
		gap: 0.125rem;
		font-size: 0.875rem;
		line-height: 1.25rem;
		margin-right: auto;
	}
	/* Mismo umbral que la navegación de Lucode: en móvil se usa el panel lateral. */
	@media (min-width: 768px) {
		.year-menu {
			display: flex;
		}
	}
	.year-menu-trigger {
		all: unset;
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		min-height: 2rem;
		padding: 0 0.625rem;
		border-radius: calc(var(--radius) - 2px);
		font-weight: 500;
		color: var(--foreground);
		cursor: pointer;
		transition: color 0.15s, background-color 0.15s;
	}
	.year-menu-trigger:hover,
	.year-menu-trigger[aria-expanded='true'],
	.year-menu-trigger.active {
		color: var(--accent-foreground);
		background-color: color-mix(in oklab, var(--accent) 80%, transparent);
	}
	.year-menu-trigger:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
	.year-menu-trigger svg {
		width: 0.875rem;
		height: 0.875rem;
		transition: transform 0.15s;
	}
	.year-menu-trigger[aria-expanded='true'] svg {
		transform: rotate(180deg);
	}
	.year-menu-panel {
		position: fixed;
		inset: auto;
		margin: 0;
		min-width: 14rem;
		max-width: 18rem;
		padding: 0.375rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--background);
		color: var(--foreground);
		box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.35);
	}
	.year-menu-panel ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2px;
	}
	.year-menu-panel a {
		display: block;
		padding: 0.5rem 0.625rem;
		border-radius: calc(var(--radius) - 2px);
		color: var(--foreground);
		text-decoration: none;
		font-size: 0.875rem;
		line-height: 1.25rem;
	}
	.year-menu-panel a:hover,
	.year-menu-panel a:focus-visible {
		background-color: var(--secondary);
		color: var(--secondary-foreground);
		outline: none;
	}
	.year-menu-panel a[aria-current='true'] {
		background-color: var(--accent);
		color: var(--accent-foreground);
		font-weight: 500;
	}
</style>
